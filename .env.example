DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Secret de hachage des codes OTP (obligatoire en production)
OTP_SECRET=change-me-with-a-long-random-string
# true = affiche l'OTP à l'écran (démo). Mettre false en production.
OTP_DEV_MODE=true
# Passerelle SMS HTTP (POST JSON {to, message, sender}). Vide = mode démonstration.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# true derrière HTTPS
COOKIE_SECURE=false
# Dossier privé des fichiers (preuves, reçus). Défaut : ./storage
STORAGE_DIR=
